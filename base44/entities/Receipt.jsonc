{
  "name": "Receipt",
  "type": "object",
  "properties": {
    "receipt_number": {
      "type": "string",
      "title": "Numero ricevuta"
    },
    "type": {
      "type": "string",
      "enum": [
        "sale",
        "purchase"
      ],
      "default": "sale",
      "title": "Tipo"
    },
    "party_name": {
      "type": "string",
      "title": "Controparte (cliente/fornitore)"
    },
    "party_email": {
      "type": "string",
      "title": "Email"
    },
    "party_address": {
      "type": "string",
      "title": "Indirizzo"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "qty": {
            "type": "number"
          },
          "unit_cents": {
            "type": "number"
          },
          "total_cents": {
            "type": "number"
          }
        }
      },
      "title": "Articoli"
    },
    "subtotal_cents": {
      "type": "number",
      "title": "Subtotale (cent)"
    },
    "tax_cents": {
      "type": "number",
      "default": 0,
      "title": "IVA (cent)"
    },
    "total_cents": {
      "type": "number",
      "title": "Totale (cent)"
    },
    "status": {
      "type": "string",
      "enum": [
        "issued",
        "void"
      ],
      "default": "issued",
      "title": "Stato"
    },
    "notes": {
      "type": "string",
      "title": "Note"
    },
    "order_id": {
      "type": "string",
      "title": "ID ordine collegato"
    },
    "payment_method": {
      "type": "string",
      "title": "Metodo pagamento"
    }
  },
  "required": [
    "receipt_number",
    "type"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
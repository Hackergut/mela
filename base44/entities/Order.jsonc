{
  "name": "Order",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string",
      "title": "Numero ordine"
    },
    "customer_name": {
      "type": "string",
      "title": "Cliente"
    },
    "customer_email": {
      "type": "string",
      "title": "Email"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "price_cents": {
            "type": "number"
          },
          "qty": {
            "type": "number"
          }
        }
      },
      "title": "Articoli"
    },
    "subtotal_cents": {
      "type": "number",
      "title": "Subtotale (cent)"
    },
    "discount_amount_cents": {
      "type": "number",
      "title": "Sconto (cent)"
    },
    "total_cents": {
      "type": "number",
      "title": "Totale (cent)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "shipped",
        "delivered",
        "cancelled"
      ],
      "default": "pending",
      "title": "Stato"
    },
    "discount_code": {
      "type": "string",
      "title": "Codice sconto"
    },
    "stripe_session_id": {
      "type": "string",
      "title": "Stripe Session ID"
    }
  },
  "required": [
    "order_number"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
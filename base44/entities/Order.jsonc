{
  "name": "Order",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string",
      "title": "Numero ordine"
    },
    "customer_name": {
      "type": "string",
      "title": "Cliente"
    },
    "customer_email": {
      "type": "string",
      "title": "Email"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "product_id": {
            "type": "string"
          },
          "variant_id": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "options": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "title": "Opzioni legacy"
          },
          "option_values": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "title": "Snapshot opzioni variante"
          },
          "image": {
            "type": "string"
          },
          "price_cents": {
            "type": "number"
          },
          "qty": {
            "type": "number"
          }
        }
      },
      "title": "Articoli"
    },
    "subtotal_cents": {
      "type": "number",
      "title": "Subtotale (cent)"
    },
    "discount_amount_cents": {
      "type": "number",
      "title": "Sconto (cent)"
    },
    "shipping_cents": {
      "type": "number",
      "title": "Spedizione (cent)"
    },
    "shipping_name": {
      "type": "string",
      "title": "Destinatario"
    },
    "shipping_phone": {
      "type": "string",
      "title": "Telefono consegna"
    },
    "shipping_address": {
      "type": "object",
      "properties": {
        "line1": { "type": "string" },
        "line2": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "postal_code": { "type": "string" },
        "country": { "type": "string" }
      },
      "title": "Indirizzo di consegna"
    },
    "total_cents": {
      "type": "number",
      "title": "Totale (cent)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "shipped",
        "delivered",
        "cancelled",
        "refunded"
      ],
      "default": "pending",
      "title": "Stato"
    },
    "discount_code": {
      "type": "string",
      "title": "Codice sconto"
    },
    "stripe_session_id": {
      "type": "string",
      "title": "Stripe Session ID"
    },
    "stripe_event_id": {
      "type": "string",
      "title": "Ultimo evento Stripe elaborato"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time",
      "title": "Data pagamento"
    },
    "tracking_number": {
      "type": "string",
      "title": "Numero tracking"
    },
    "carrier": {
      "type": "string",
      "enum": [
        "",
        "DHL",
        "UPS",
        "FedEx",
        "BRT",
        "Poste Italiane",
        "SDA"
      ],
      "default": "",
      "title": "Corriere"
    },
    "shipped_date": {
      "type": "string",
      "format": "date-time",
      "title": "Data spedizione"
    },
    "delivered_date": {
      "type": "string",
      "format": "date-time",
      "title": "Data consegna"
    },
    "receipt_number": {
      "type": "string",
      "title": "Numero ricevuta"
    }
  },
  "required": [
    "order_number"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
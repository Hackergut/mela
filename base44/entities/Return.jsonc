{
  "name": "Return",
  "type": "object",
  "properties": {
    "return_number": {
      "type": "string",
      "title": "Numero reso"
    },
    "order_number": {
      "type": "string",
      "title": "Ordine di origine"
    },
    "order_id": {
      "type": "string",
      "title": "ID ordine"
    },
    "product_name": {
      "type": "string",
      "title": "Prodotto"
    },
    "product_id": {
      "type": "string",
      "title": "ID prodotto"
    },
    "variant_id": {
      "type": "string",
      "title": "ID variante"
    },
    "sku": {
      "type": "string",
      "title": "SKU"
    },
    "customer_name": {
      "type": "string",
      "title": "Cliente"
    },
    "customer_email": {
      "type": "string",
      "title": "Email"
    },
    "reason": {
      "type": "string",
      "enum": [
        "defective",
        "wrong_item",
        "not_as_described",
        "changed_mind",
        "damaged",
        "other"
      ],
      "default": "other",
      "title": "Motivo"
    },
    "quantity": {
      "type": "number",
      "default": 1,
      "title": "Quantit\u00e0"
    },
    "refund_cents": {
      "type": "number",
      "default": 0,
      "title": "Rimborso (cent)"
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "approved",
        "completed",
        "rejected"
      ],
      "default": "requested",
      "title": "Stato"
    },
    "notes": {
      "type": "string",
      "title": "Note"
    }
  },
  "required": [
    "return_number"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
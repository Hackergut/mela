{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Nome"
    },
    "slug": {
      "type": "string",
      "title": "Slug pubblico"
    },
    "subtitle": {
      "type": "string",
      "title": "Sottotitolo"
    },
    "brand": {
      "type": "string",
      "default": "Apple",
      "title": "Brand"
    },
    "family": {
      "type": "string",
      "title": "Famiglia prodotto"
    },
    "sku": {
      "type": "string",
      "title": "SKU"
    },
    "price": {
      "type": "string",
      "title": "Prezzo (testo)"
    },
    "price_cents": {
      "type": "number",
      "title": "Prezzo in centesimi"
    },
    "cost_cents": {
      "type": "number",
      "title": "Costo di acquisto (cent)"
    },
    "stock": {
      "type": "number",
      "default": 0,
      "title": "Giacenza magazzino"
    },
    "low_stock_threshold": {
      "type": "number",
      "default": 5,
      "title": "Soglia stock basso"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "withdrawn",
        "discontinued"
      ],
      "default": "active",
      "title": "Stato vendita"
    },
    "badge": {
      "type": "string",
      "title": "Badge"
    },
    "category": {
      "type": "string",
      "title": "Categoria"
    },
    "category_id": {
      "type": "string",
      "title": "ID categoria"
    },
    "option_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Nomi opzioni variante"
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "title": "In evidenza"
    },
    "compare_group": {
      "type": "string",
      "title": "Gruppo confronto"
    },
    "specs": {
      "type": "object",
      "title": "Specifiche tecniche",
      "additionalProperties": {
        "type": "string"
      }
    },
    "image": {
      "type": "string",
      "title": "Immagine principale",
      "format": "url"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Galleria immagini"
    },
    "colors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "hex": {
            "type": "string"
          },
          "image": {
            "type": "string"
          }
        }
      },
      "title": "Colori"
    },
    "description": {
      "type": "string",
      "title": "Descrizione"
    },
    "sort_order": {
      "type": "number",
      "title": "Ordine"
    },
    "is_mockup": {
      "type": "boolean",
      "default": false,
      "title": "Mockup (dato demo)"
    },
    "shopify_product_id": {
      "type": "string",
      "title": "Shopify Product ID"
    },
    "source": {
      "type": "string",
      "enum": [
        "base44",
        "shopify",
        "legacy"
      ],
      "default": "base44",
      "title": "Origine"
    },
    "synced_at": {
      "type": "string",
      "format": "date-time",
      "title": "Ultima sincronizzazione"
    }
  },
  "required": [
    "name",
    "price",
    "category",
    "image"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
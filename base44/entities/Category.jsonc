{
  "name": "Category",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Nome"
    },
    "slug": {
      "type": "string",
      "title": "Slug pubblico"
    },
    "description": {
      "type": "string",
      "title": "Descrizione"
    },
    "parent_id": {
      "type": "string",
      "title": "Categoria principale"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "hidden"
      ],
      "default": "active",
      "title": "Stato"
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "title": "In evidenza"
    },
    "image": {
      "type": "string",
      "title": "Immagine copertina",
      "format": "url"
    },
    "sort_order": {
      "type": "number",
      "title": "Ordine"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
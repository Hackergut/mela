{
  "name": "ProductVariant",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string",
      "title": "ID prodotto"
    },
    "title": {
      "type": "string",
      "title": "Nome variante"
    },
    "sku": {
      "type": "string",
      "title": "SKU"
    },
    "barcode": {
      "type": "string",
      "title": "Barcode"
    },
    "option_values": {
      "type": "object",
      "title": "Opzioni",
      "additionalProperties": {
        "type": "string"
      }
    },
    "color_hex": {
      "type": "string",
      "title": "Colore HEX"
    },
    "price_cents": {
      "type": "number",
      "title": "Prezzo in centesimi"
    },
    "compare_at_cents": {
      "type": "number",
      "title": "Prezzo precedente in centesimi"
    },
    "cost_cents": {
      "type": "number",
      "title": "Costo in centesimi"
    },
    "stock": {
      "type": "number",
      "default": 0,
      "title": "Giacenza"
    },
    "low_stock_threshold": {
      "type": "number",
      "default": 5,
      "title": "Soglia stock basso"
    },
    "image": {
      "type": "string",
      "format": "url",
      "title": "Immagine variante"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Galleria variante"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "draft",
        "archived"
      ],
      "default": "active",
      "title": "Stato"
    },
    "is_default": {
      "type": "boolean",
      "default": false,
      "title": "Variante predefinita"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "title": "Ordine"
    },
    "shopify_product_id": {
      "type": "string",
      "title": "Shopify Product ID"
    },
    "shopify_variant_id": {
      "type": "string",
      "title": "Shopify Variant ID"
    },
    "synced_at": {
      "type": "string",
      "format": "date-time",
      "title": "Ultima sincronizzazione"
    }
  },
  "required": [
    "product_id",
    "title",
    "sku",
    "price_cents"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}

{
  "name": "Customer",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Nome"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "phone": {
      "type": "string",
      "title": "Telefono"
    },
    "notes": {
      "type": "string",
      "title": "Note"
    },
    "total_spent": {
      "type": "number",
      "default": 0,
      "title": "Totale speso (cent)"
    },
    "orders_count": {
      "type": "number",
      "default": 0,
      "title": "Numero ordini"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Tag"
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
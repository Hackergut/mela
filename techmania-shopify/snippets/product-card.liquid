{%- comment -%}
  TechMania Product Card Snippet
{%- endcomment -%}

<div class="tm-product-card">
  {%- if product.compare_at_price > product.price -%}
    <span class="tm-product-badge">
      Sconto {{ product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round }}%
    </span>
  {%- endif -%}

  <a href="{{ product.url }}" class="tm-product-img-wrapper">
    {%- if product.featured_media -%}
      <img
        src="{{ product.featured_media | image_url: width: 400 }}"
        alt="{{ product.featured_media.alt | escape }}"
        class="tm-product-img"
        loading="lazy"
      >
    {%- else -%}
      <div class="w-full h-full bg-gray-200 rounded-lg flex items-center justify-center text-xs font-bold text-gray-400">TechMania</div>
    {%- endif -%}
  </a>

  <div class="flex-1 flex flex-col justify-between">
    <div>
      <span class="tm-product-brand">{{ product.vendor | default: "TechMania" }}</span>
      <a href="{{ product.url }}" class="tm-product-title block">
        {{ product.title }}
      </a>
    </div>

    <div class="mt-3 pt-3 border-t border-gray-100 flex items-center justify-between">
      <div>
        <span class="tm-product-price">{{ product.price | money }}</span>
        {%- if product.compare_at_price > product.price -%}
          <span class="tm-product-old-price">{{ product.compare_at_price | money }}</span>
        {%- endif -%}
      </div>

      <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data">
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <button
          type="submit"
          class="w-9 h-9 rounded-full bg-black text-white hover:bg-gray-800 transition-colors flex items-center justify-center"
          title="Aggiungi al carrello"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
        </button>
      </form>
    </div>
  </div>
</div>

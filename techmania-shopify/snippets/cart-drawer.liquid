<div class="tm-drawer-overlay" data-cart-overlay></div>

<div class="tm-drawer" data-cart-drawer>
  <div class="tm-drawer-header">
    <div class="flex items-center gap-2">
      <svg class="w-5 h-5 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
      <h3 class="text-base font-black uppercase text-black">Il Tuo Carrello ({{ cart.item_count }})</h3>
    </div>
    <button class="p-2 rounded-full hover:bg-gray-100 transition-colors" data-cart-close aria-label="Chiudi carrello">
      <svg class="w-5 h-5 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
  </div>

  <div class="tm-drawer-body">
    {%- if cart.item_count > 0 -%}
      <div class="space-y-4">
        {%- for item in cart.items -%}
          <div class="flex gap-4 p-3 bg-gray-50 rounded-2xl border border-gray-100 items-center">
            <div class="w-16 h-16 bg-white rounded-xl p-1 flex-shrink-0 flex items-center justify-center border border-gray-100">
              {%- if item.image -%}
                <img src="{{ item.image | image_url: width: 120 }}" alt="{{ item.title | escape }}" class="max-h-full max-w-full object-contain">
              {%- else -%}
                <div class="w-full h-full bg-gray-200 rounded"></div>
              {%- endif -%}
            </div>
            <div class="flex-1 min-w-0">
              <h4 class="text-xs font-bold text-black truncate">{{ item.product.title }}</h4>
              {%- unless item.product.has_only_default_variant -%}
                <p class="text-[10px] text-gray-500 font-semibold">{{ item.variant.title }}</p>
              {%- endunless -%}
              <div class="flex items-center justify-between mt-2">
                <span class="text-xs font-black text-black">{{ item.final_line_price | money }}</span>
                <span class="text-[10px] font-bold text-gray-400">Qtà: {{ item.quantity }}</span>
              </div>
            </div>
            <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" class="text-gray-400 hover:text-red-500 p-1">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
            </a>
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="text-center py-12 space-y-4">
        <svg class="w-12 h-12 text-gray-300 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
        <p class="text-sm font-bold text-gray-500">Il tuo carrello è vuoto</p>
        <a href="/collections/all" class="inline-block bg-black text-white text-xs font-bold px-6 py-3 rounded-full hover:bg-gray-800 transition-colors">
          Inizia lo Shopping
        </a>
      </div>
    {%- endif -%}
  </div>

  {%- if cart.item_count > 0 -%}
    <div class="tm-drawer-footer">
      <div class="flex items-center justify-between mb-4">
        <span class="text-xs font-bold text-gray-500 uppercase">Totale Parziale</span>
        <span class="text-lg font-black text-black">{{ cart.total_price | money }}</span>
      </div>
      <form action="{{ routes.cart_url }}" method="post">
        <button type="submit" name="checkout" class="w-full bg-black hover:bg-gray-800 text-white text-xs font-extrabold uppercase tracking-wider py-4 rounded-xl transition-colors text-center shadow-lg">
          Procedi al Checkout
        </button>
      </form>
    </div>
  {%- endif -%}
</div>

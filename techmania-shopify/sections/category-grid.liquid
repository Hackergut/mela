<section class="py-12 bg-white border-t border-gray-100">
  <div class="container-tm">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h2 class="text-2xl font-black text-black tracking-tight">Esplora per Categoria</h2>
        <p class="text-xs text-gray-500 font-semibold mt-1">Trova subito la tecnologia perfetta per te</p>
      </div>
    </div>

    <div class="tm-category-grid">
      
      <a href="/collections/smartphones" class="tm-cat-card">
        <div class="tm-cat-icon text-black">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
        </div>
        <div class="tm-cat-name">Smartphones</div>
        <div class="tm-cat-sub">iPhone & Galaxy</div>
      </a>

      <a href="/collections/cameras" class="tm-cat-card">
        <div class="tm-cat-icon text-black">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/><circle cx="12" cy="13" r="3"/></svg>
        </div>
        <div class="tm-cat-name">Fotocamere</div>
        <div class="tm-cat-sub">Pro & Mirrorless</div>
      </a>

      <a href="/collections/headphones" class="tm-cat-card">
        <div class="tm-cat-icon text-black">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/></svg>
        </div>
        <div class="tm-cat-name">Cuffie & Audio</div>
        <div class="tm-cat-sub">AirPods & Hi-Fi</div>
      </a>

      <a href="/collections/computers" class="tm-cat-card">
        <div class="tm-cat-icon text-black">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        </div>
        <div class="tm-cat-name">Computer</div>
        <div class="tm-cat-sub">MacBook & PC</div>
      </a>

      <a href="/collections/gaming" class="tm-cat-card">
        <div class="tm-cat-icon text-black">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 002 2h14a2 2 0 002-2V7a2 2 0 00-2-2H5z"/></svg>
        </div>
        <div class="tm-cat-name">Gaming</div>
        <div class="tm-cat-sub">PS5 & Visori</div>
      </a>

      <a href="/collections/smartwatches" class="tm-cat-card">
        <div class="tm-cat-icon text-black">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <div class="tm-cat-name">Smartwatch</div>
        <div class="tm-cat-sub">Apple Watch</div>
      </a>

    </div>
  </div>
</section>


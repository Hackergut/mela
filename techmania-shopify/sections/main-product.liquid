<section class="py-12 bg-white">
  <div class="container-tm">
    
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-2 text-xs text-gray-500 mb-8">
      <a href="{{ routes.root_url }}" class="hover:text-black">Home</a>
      <span>&rsaquo;</span>
      <a href="/collections/all" class="hover:text-black">Prodotti</a>
      <span>&rsaquo;</span>
      <span class="font-semibold text-black truncate">{{ product.title }}</span>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-16">
      
      <!-- Gallery -->
      <div class="flex flex-col-reverse sm:flex-row gap-4">
        
        <!-- Thumbnails -->
        <div class="flex sm:flex-col gap-3 overflow-x-auto sm:overflow-y-auto max-h-[480px]">
          {%- for image in product.images -%}
            <button class="w-20 h-20 rounded-2xl bg-gray-100 p-2 border border-gray-200 overflow-hidden flex-shrink-0">
              <img src="{{ image | image_url: width: 160 }}" alt="{{ product.title | escape }}" class="w-full h-full object-contain mix-blend-multiply">
            </button>
          {%- endfor -%}
        </div>

        <!-- Main Image Preview -->
        <div class="flex-1 bg-gray-100 rounded-3xl p-8 flex items-center justify-center min-h-[380px] sm:min-h-[480px] relative overflow-hidden">
          {%- if product.featured_image -%}
            <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}" class="max-h-[380px] max-w-full object-contain mix-blend-multiply">
          {%- endif -%}

          {%- if product.compare_at_price > product.price -%}
            <span class="absolute top-6 left-6 bg-black text-white text-xs font-bold px-3 py-1.5 rounded-full uppercase">
              Sconto {{ product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round }}%
            </span>
          {%- endif -%}
        </div>

      </div>

      <!-- Product Form / Details -->
      <div class="space-y-6">
        
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-gray-400">{{ product.vendor }}</span>
          <h1 class="text-3xl font-black text-black tracking-tight mt-1">{{ product.title }}</h1>
          
          <div class="flex items-center gap-4 mt-3">
            <span class="text-xs font-semibold text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-full flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Disponibile in Magazzino
            </span>
          </div>
        </div>

        <!-- Price -->
        <div class="flex items-baseline gap-3 pb-4 border-b border-gray-100">
          <span class="text-3xl font-black text-black">{{ product.price | money }}</span>
          {%- if product.compare_at_price > product.price -%}
            <span class="text-lg text-gray-400 line-through">{{ product.compare_at_price | money }}</span>
          {%- endif -%}
        </div>

        <!-- Variant Options Form -->
        {% form 'product', product, class: 'space-y-6' %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              <div>
                <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">
                  {{ option.name }}:
                </label>
                <div class="flex flex-wrap gap-2">
                  {%- for value in option.values -%}
                    <label class="px-4 py-2.5 rounded-xl border border-gray-200 text-xs font-bold cursor-pointer hover:border-black transition-colors">
                      <input type="radio" name="{{ option.name }}" value="{{ value | escape }}" class="sr-only" data-variant-radio>
                      <span>{{ value }}</span>
                    </label>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          {%- endunless -%}

          <!-- Quantity + Add to Cart -->
          <div class="flex flex-col sm:flex-row items-center gap-4 pt-4">
            
            <div class="flex items-center border border-gray-200 rounded-xl bg-gray-50 p-1">
              <input type="number" name="quantity" value="1" min="1" class="w-16 text-center text-sm font-bold bg-transparent border-none">
            </div>

            <button type="submit" class="flex-1 w-full bg-black hover:bg-gray-800 text-white font-extrabold py-4 px-6 rounded-xl transition-all shadow-lg text-xs uppercase tracking-wider">
              Aggiungi al Carrello
            </button>

          </div>
        {% endform %}

        <!-- Guarantees -->
        <div class="grid grid-cols-3 gap-2 pt-6 border-t border-gray-100 text-center">
          <div class="p-2">
            <span class="text-[11px] font-bold text-gray-700 block">Spedizione Express</span>
            <span class="text-[10px] text-gray-400 block">Consegna in 24/48h</span>
          </div>
          <div class="p-2">
            <span class="text-[11px] font-bold text-gray-700 block">Garanzia 2 Anni</span>
            <span class="text-[10px] text-gray-400 block">Assistenza diretta</span>
          </div>
          <div class="p-2">
            <span class="text-[11px] font-bold text-gray-700 block">Reso Facile</span>
            <span class="text-[10px] text-gray-400 block">30 giorni di prova</span>
          </div>
        </div>

      </div>

    </div>

    <!-- Product Description -->
    <div class="border-t border-gray-200 pt-12">
      <h3 class="text-xl font-black text-black mb-4">Descrizione Prodotto</h3>
      <div class="prose max-w-none text-sm text-gray-700 leading-relaxed">
        {{ product.description }}
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Pagina Prodotto",
  "settings": []
}
{% endschema %}
